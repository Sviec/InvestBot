# Скопируйте файл в .env и заполните значения.
# Переменные без значения по умолчанию обязательны: без них бот не стартует.

# --- Telegram ---
BOT_TOKEN=123456789:AA...replace-me
# Язык интерфейса: ru или en (en.json пока пуст, используется откат на ru)
BOT_LANGUAGE=ru

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=investbot
DB_USER=investbot
DB_PASSWORD=change-me
# Размер пула соединений; держите не меньше WORKER_THREADS / 2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Секунды: пересоздание соединения и таймаут подключения
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
# Миллисекунды: сервер прервёт слишком долгий запрос
DB_STATEMENT_TIMEOUT_MS=15000
DB_RETRY_ATTEMPTS=3

# --- Логирование ---
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- Пул потоков и таймауты (секунды) ---
# Блокирующие вызовы (БД, yfinance, matplotlib) исполняются в этом пуле.
WORKER_THREADS=6
DB_TIMEOUT=20
MARKET_TIMEOUT=14
RENDER_TIMEOUT=60
# Сколько отчётов рисуется одновременно
RENDER_CONCURRENCY=2
# Сколько рыночных запросов идёт одновременно. Должно быть меньше
# WORKER_THREADS: остаток пула остаётся свободным для работы с БД, поэтому
# недоступный провайдер не мешает открыть профиль или избранное.
MARKET_CONCURRENCY=3

# --- Кеш и запросы к провайдеру рыночных данных ---
MARKET_CACHE_SIZE=512
# Базовый TTL, если ярус не задан (секунды)
MARKET_CACHE_TTL=300
# Сколько секунд устаревший ответ ещё можно отдать, если провайдер недоступен
MARKET_CACHE_STALE_TTL=3600
MARKET_RETRY_ATTEMPTS=2
# Сколько хранится ответ «тикер не найден» или «данных нет»
MARKET_NEGATIVE_TTL=120
# Ярусы кеша: данные меняются с разной частотой, общий TTL в 5 минут
# заставлял бы перезапрашивать квартальную отчётность без нужды.
MARKET_CACHE_TTL_FUNDAMENTALS=86400
MARKET_CACHE_TTL_INFO=1800
MARKET_CACHE_TTL_DIVIDENDS=43200
MARKET_CACHE_TTL_HISTORY_SHORT=900
MARKET_CACHE_TTL_HISTORY_LONG=21600
# Полный OHLCV для техиндикаторов (отдельный кеш от Close)
MARKET_CACHE_TTL_OHLCV_SHORT=900
MARKET_CACHE_TTL_OHLCV_LONG=21600
# Последняя цена для оценки портфеля (пакетный запрос)
MARKET_CACHE_TTL_QUOTE=900
MARKET_CACHE_TTL_NEWS=900
MARKET_CACHE_TTL_OVERVIEW=21600
MARKET_CACHE_TTL_RANKINGS=10800
# Целевые цены аналитиков и дата следующего отчёта
MARKET_CACHE_TTL_ANALYST=21600
# Сколько открытых позиций оценивать рыночными котировками
PORTFOLIO_VALUATION_LIMIT=50
# Таймаут одного запроса к провайдеру. Держите заметно меньше MARKET_TIMEOUT,
# иначе на повторную попытку не останется времени.
MARKET_HTTP_TIMEOUT=5
# TLS/HTTP-отпечаток браузера (curl_cffi impersonate). Yahoo режет запросы
# без него ответом 429. По умолчанию chrome, как у yfinance; пустая строка
# отключает подмену.
MARKET_IMPERSONATE=chrome
# Прокси для запросов к Yahoo Finance. Провайдер доступен не из всех регионов:
# без прокси запросы оттуда завершаются таймаутом или ответом 429.
# MARKET_PROXY=http://user:password@host:port

# --- Ограничение частоты запросов ---
# Минимальный интервал между событиями от одного пользователя, секунды.
# 0 отключает ограничение.
THROTTLE_RATE=0.7

# --- Телеметрия действий ---
# Ёмкость очереди до записи в БД; при переполнении события отбрасываются.
EVENTS_QUEUE_SIZE=10000
# Размер пачки INSERT и интервал сброса неполной пачки (секунды).
EVENTS_BATCH_SIZE=50
EVENTS_FLUSH_INTERVAL=2
# Сколько суток хранить историю; старые записи удаляются при старте.
EVENTS_RETENTION_DAYS=90

# --- Отчёты ---
# Больше этого размера отчёт уходит документом, а не фотографией
MAX_PHOTO_BYTES=9000000
MAX_REPORT_ROWS=40
MAX_REPORT_COLUMNS=8
