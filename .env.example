# Скопируйте файл в .env и заполните значения.
# Переменные без значения по умолчанию обязательны: без них бот не стартует.

# --- Telegram ---
BOT_TOKEN=123456789:AA...replace-me
# Язык интерфейса: ru или en (en.json пока пуст, используется откат на ru)
BOT_LANGUAGE=ru

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=investbot
DB_USER=investbot
DB_PASSWORD=change-me
# Размер пула соединений; держите не меньше WORKER_THREADS / 2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Секунды: пересоздание соединения и таймаут подключения
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
# Миллисекунды: сервер прервёт слишком долгий запрос
DB_STATEMENT_TIMEOUT_MS=15000
DB_RETRY_ATTEMPTS=3

# --- Redis (хранилище состояний диалога) ---
# Без него состояние живёт в памяти процесса: теряется при перезапуске и
# не позволяет запустить второй экземпляр бота.
REDIS_URL=redis://localhost:6379/0

# --- Логирование ---
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- Пул потоков и таймауты (секунды) ---
# Блокирующие вызовы (БД, yfinance, matplotlib) исполняются в этом пуле.
WORKER_THREADS=8
DB_TIMEOUT=20
MARKET_TIMEOUT=30
RENDER_TIMEOUT=60
# Сколько отчётов рисуется одновременно
RENDER_CONCURRENCY=2
# Сколько рыночных запросов идёт одновременно. Должно быть меньше
# WORKER_THREADS: остаток пула остаётся свободным для работы с БД, поэтому
# недоступный провайдер не мешает открыть профиль или избранное.
MARKET_CONCURRENCY=4

# --- Кеш и запросы к провайдеру рыночных данных ---
MARKET_CACHE_SIZE=512
# Сколько секунд ответ провайдера считается свежим
MARKET_CACHE_TTL=300
# Сколько секунд устаревший ответ ещё можно отдать, если провайдер недоступен
MARKET_CACHE_STALE_TTL=3600
MARKET_RETRY_ATTEMPTS=3
# Сколько хранится ответ «тикер не найден» или «данных нет»
MARKET_NEGATIVE_TTL=120
# Таймаут одного запроса к провайдеру. Держите заметно меньше MARKET_TIMEOUT,
# иначе на повторную попытку не останется времени.
MARKET_HTTP_TIMEOUT=8
# Прокси для запросов к Yahoo Finance. Провайдер доступен не из всех регионов:
# без прокси запросы оттуда завершаются таймаутом или ответом 429.
# MARKET_PROXY=http://user:password@host:port

# --- Ограничение частоты запросов ---
# Минимальный интервал между событиями от одного пользователя, секунды.
# 0 отключает ограничение.
THROTTLE_RATE=0.7

# --- Отчёты ---
# Больше этого размера отчёт уходит документом, а не фотографией
MAX_PHOTO_BYTES=9000000
MAX_REPORT_ROWS=40
MAX_REPORT_COLUMNS=8
